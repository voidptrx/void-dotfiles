include ~/.config/sway/configs/colorscheme

# Assign windows to workspaces
assign [app_id="(?i)librewolf"] workspace number 2
assign [title="(?i)nvim"] workspace number 3
assign [class="(?i)spotify"] workspace number 4
assign [app_id="(?i)thunar"] workspace number 5
assign [class="(?i)steam"] workspace number 6
assign [app_id="(?i)libreoffice-*"] workspace number 7
assign [app_id="(?i)chromium"] workspace number 10

for_window [app_id="librewolf" title="Picture-in-Picture"] {
    floating enable
    border none
    move container to output eDP-1
    resize set 945 525
    move position 955 535
}

# Border config
smart_borders on
default_border pixel 2
default_floating_border pixel 2
default_orientation auto

# Gaps config
gaps inner 10

# Xwayland support
xwayland enable

# Enable thinkPad touchpad
input "1739:0:Synaptics_TM3276-022" {
    dwt enabled
    tap enabled
    middle_emulation enabled
}

# Property Name          Border        BG            Text       Indicator   Child Border
client.focused           $dark-blue    $dark-green   $fg-color  $blue       $dark-green
client.focused_inactive  $dark-purple  $dark-purple  $fg-color  $bg-color   $bg-color
client.unfocused         $dark-blue    $bg-color     $fg-color  $bg-color   $bg-color
client.urgent            $red          $red          $bg-color  $red        $red
client.placeholder       $bg-color     $bg-color     $fg-color  $bg-color   $bg-color
client.background        $fg-color

# Font
font pango:Terminess Nerd Font Mono 11
