{
  "include": ["modules.jsonc"],
  "reload_style_on_change": true,
  "height": 30,
  "fixed-center": true,
  "output": "Lenovo Group Limited L27m-30 UPB67FNK",
  "modules-left": ["custom/power", "sway/workspaces", "mpris"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/weather",
    "tray",
    "pulseaudio#speaker",
    "pulseaudio#mic",
    "upower",
  ],
}
