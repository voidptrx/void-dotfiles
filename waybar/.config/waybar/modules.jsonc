{
  "sway/workspaces": {
    "format": "{value}",
    "disable-scroll": true,
    "all-outputs": true,
  },

  "sway/mode": {
    "format": "[{}]",
  },

  "mpris": {
    "format": "♪ {artist} - {title}",
    "format-paused": "♪ {artist} - {title}",
    "ignored-players": ["firefox", "kdeconnect"],
  },

  "clock": {
    "interval": 60,
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}",
  },

  "network": {
    "interval": 30,
    "format-wifi": "WIFI {signalStrength}%",
    "format-ethernet": "NET",
    "format-linked": "LINK",
    "format-disconnected": "OFFLINE",
    "format-disabled": "WIFI OFF",
    "tooltip-format-wifi": "{essid}\n{ifname}: {ipaddr}",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}",
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "MUTED",
    "tooltip-format": "{desc}",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
  },

  "battery": {
    "interval": 60,
    "weighted-average": true,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "BAT {capacity}%",
    "format-charging": "BAT {capacity}% +",
    "format-plugged": "BAT {capacity}% AC",
    "format-full": "BAT FULL",
    "tooltip-format": "{timeTo}",
  },

  "tray": {
    "icon-size": 13,
    "spacing": 8,
  },
}
